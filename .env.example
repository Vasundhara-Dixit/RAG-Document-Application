# Application Environment
APP_ENV=development
LOG_LEVEL=INFO
CONFIG_PATH=configs/config.yaml

# Security & Data Governance
ALLOW_EXTERNAL_LLM=false

# LLM & Embedding API Keys (Optional if running local models)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Storage Paths
DATABASE_URL=sqlite:///data/rag_app.db
RAW_DATA_DIR=data/raw
CHROMA_PERSIST_DIR=data/index/chroma
FAISS_INDEX_PATH=data/index/faiss.index
GOLDEN_SET_DIR=data/golden

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

